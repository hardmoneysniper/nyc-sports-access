# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Exported per-NTA drill-down data (tract/route/facility) -- ~566MB total,
# covering all 262 NTAs, but the methodology page's Travel Time tab only
# ever needs Elmhurst's (QN0401) slice of it for its one worked example.
# Ignore the directories wholesale, then un-ignore just those specific
# files, so the ones actually fetched at runtime still deploy. Per project
# owner instruction, 2026-10-06 (found during a "why is this slow/missing
# in production" check -- the whole directories were gitignored with a
# stale comment claiming nothing live used them).
/public/data/routes/*
!/public/data/routes/QN0401_soccer_weekday_evening.geojson
/public/data/tracts/*
!/public/data/tracts/QN0401.geojson
/public/data/facilities/*
!/public/data/facilities/soccer.geojson
/public/data/nta_boundaries.geojson
